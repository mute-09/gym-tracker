# Jangan commit file .env asli.

PORT=3005
DB_PATH=/home/muthi/gym-assitant-v2/data/gym.db

# Generate dengan: openssl rand -hex 32
SESSION_SECRET=<generate: openssl rand -hex 32>

ADMIN_USERNAME=admin
ADMIN_PASSWORD=<ganti, min 8>

COOKIE_SECURE=true
NODE_ENV=production
